# Used by Docker Compose. Defaults are compatible with hekatoncheiros-core/docker-compose.yml.
INVENTORY_DATABASE_URL=postgres://hc_user:hc_password@postgres:5432/hc_core
INVENTORY_INSTALLER_TOKEN_SECRET=dev-compose-installer-secret-change-me
INVENTORY_INSTALLER_TOKEN_ISSUER=hekatoncheiros-core-installer

# Used by npm run dev / npm run db:migrate outside Docker.
DATABASE_URL=postgres://hc_user:hc_password@localhost:5432/hc_core
INSTALLER_TOKEN_SECRET=dev-compose-installer-secret-change-me
INSTALLER_TOKEN_ISSUER=hekatoncheiros-core-installer
PORT=4010
