{
  "app_id": "talpaversum/inventory",
  "app_name": "Inventory",
  "version": "0.1.0",
  "vendor": {
    "name": "Talpaversum",
    "website": "https://github.com/Talpaversum"
  },
  "tenancy": {
    "scope": "tenant",
    "cross_tenant_collaboration": {
      "supported": false,
      "shareables": []
    }
  },
  "data": {
    "schemas": ["inventory"],
    "no_cross_app_access": true
  },
  "privileges": {
    "required": ["inventory.read"],
    "optional": [
      "inventory.write",
      "inventory.admin",
      "inventory.approve_order",
      "inventory.create_item",
      "inventory.update_item",
      "inventory.delete_item"
    ]
  },
  "impersonation": {
    "supported": true,
    "allowed_roles": ["core.admin.tenant", "core.admin.department", "core.admin.group"],
    "allow_cross_tenant": false
  },
  "delegation": {
    "supported": true,
    "actions": [
      "inventory.approve_order",
      "inventory.create_item",
      "inventory.update_item",
      "inventory.delete_item"
    ]
  },
  "licensing": {
    "required": true,
    "issuer_url": "http://host.docker.internal:4030",
    "enforced_by_app": true,
    "offline_supported": true,
    "modes": ["perpetual", "time_limited", "scale_limited"],
    "expiry_behavior": {
      "non_destructive": true,
      "read_only": true,
      "api_read_only": true
    },
    "features": {
      "batch_import": false,
      "multi_location": false,
      "barcode_scanning": false,
      "custom_fields": false,
      "attachments": false,
      "audit_export": false
    },
    "limits": {
      "items_max": { "type": "count", "unit": "items" },
      "locations_max": { "type": "count", "unit": "locations" },
      "custom_fields_max": { "type": "count", "unit": "fields" },
      "attachments_gb_max": { "type": "size", "unit": "gb" }
    }
  },
  "integration": {
    "slug": "inventory",
    "api": {
      "exposes": {
        "base_path": "/apps/inventory",
        "version": "v1"
      },
      "consumes_core_api": true
    },
    "events": {
      "emits": [
        "inventory.item.created",
        "inventory.item.updated",
        "inventory.item.deleted",
        "inventory.stock.adjusted"
      ],
      "consumes": [
        "core.license.changed",
        "core.user.updated",
        "core.tenant.policy.changed"
      ],
      "idempotent_consumers": true
    },
    "ui": {
      "artifact": {
        "url": "/internal/ui/plugin.js",
        "auth": "core-signed-token"
      },
      "nav_entries": [
        {
          "label": "Overview",
          "path": "/app/inventory",
          "required_privileges": ["inventory.read"]
        },
        {
          "label": "Items",
          "path": "/app/inventory/items",
          "required_privileges": ["inventory.read"]
        },
        {
          "label": "Locations",
          "path": "/app/inventory/locations",
          "required_privileges": ["inventory.read"]
        },
        {
          "label": "Templates",
          "path": "/app/inventory/templates",
          "required_privileges": ["inventory.read"]
        },
        {
          "label": "Attribute types",
          "path": "/app/inventory/attributes",
          "required_privileges": ["inventory.read"]
        }
      ],
      "help_entries": [
        {
          "title": "Create an inventory item template",
          "summary": "Create a reusable template with a tenant scope and custom attributes.",
          "outcome": "The new template is available when creating inventory items.",
          "category": "Inventory",
          "steps": [
            "Open Inventory / Attribute types and prepare the attributes used by the template.",
            "Open Inventory / Templates.",
            "Enter a template name and select its tenant scope.",
            "Add the attributes that the template should contain.",
            "Mark required fields and save the template."
          ],
          "path": "/app/inventory/templates",
          "required_privileges": ["inventory.read"]
        },
        {
          "title": "Create an inventory item",
          "summary": "Add a new physical or logical item to the inventory.",
          "outcome": "The item is stored in the tenant inventory and appears in the item list.",
          "category": "Inventory",
          "steps": [
            "Open Inventory / Items.",
            "Enter a name and inventory number.",
            "Select a template, location, owner, and manager where applicable.",
            "Review the data and save the item."
          ],
          "path": "/app/inventory/items",
          "required_privileges": ["inventory.read"]
        },
        {
          "title": "Create an inventory location",
          "summary": "Create a location that can be assigned to inventory items.",
          "outcome": "The location is available in item forms and the location overview.",
          "category": "Inventory",
          "steps": [
            "Open Inventory / Locations.",
            "Enter a location name and optional code.",
            "Save the location.",
            "Select this location in the Location field when creating or editing an item."
          ],
          "path": "/app/inventory/locations",
          "required_privileges": ["inventory.read"]
        }
      ]
    }
  }
}
